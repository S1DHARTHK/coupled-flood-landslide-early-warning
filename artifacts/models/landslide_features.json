{
  "model": "landslide_xgboost",
  "version": "1.0",
  "target": "landslide",
  "feature_order": [
    "rainfall_1d_mm",
    "rainfall_3d_mm",
    "rainfall_7d_mm",
    "rainfall_14d_mm",
    "rainfall_30d_mm",
    "soil_moisture",
    "temperature_c",
    "humidity_percent",
    "elevation_m",
    "slope_degree",
    "aspect_degree",
    "curvature",
    "land_cover",
    "lithology"
  ],
  "n_features": 14,
  "n_trees": 38,
  "best_iteration": 37,
  "common_features": [
    "rainfall_1d_mm",
    "rainfall_3d_mm",
    "rainfall_7d_mm",
    "rainfall_14d_mm",
    "rainfall_30d_mm",
    "soil_moisture",
    "temperature_c",
    "humidity_percent",
    "elevation_m"
  ],
  "landslide_specific_features": [
    "slope_degree",
    "aspect_degree",
    "curvature",
    "land_cover",
    "lithology"
  ],
  "categorical_features": [
    "land_cover",
    "lithology"
  ],
  "categorical_handling": {
    "method": "xgboost native categorical (enable_categorical=True)",
    "pandas_dtype": "CategoricalDtype(categories=<below>, ordered=False)",
    "one_hot": false,
    "category_schema": {
      "land_cover": [
        "forest",
        "agriculture",
        "shrubland",
        "built_up",
        "barren"
      ],
      "lithology": [
        "granite_gneiss",
        "laterite",
        "schist",
        "sandstone",
        "shale",
        "alluvium"
      ]
    },
    "note": "Category ORDER defines the integer codes and must be reused verbatim at inference. Codes are nominal identifiers, not an ordering. Source: DATA_DICTIONARY.md section 4."
  },
  "excluded_columns": {
    "flood": "other hazard target -- keeps this baseline independent",
    "flood_probability/flood_prediction": "flood model outputs; reserved for the TCDL, not for this model",
    "river_level_m/distance_to_river_km/drainage_density": "flood-specific predictors",
    "date": "chronological split key only",
    "latitude/longitude": "metadata only; excluded to prevent the model memorising the 14 district points",
    "district": "identifier / mapping only, never a feature"
  },
  "decision_threshold": 0.5,
  "note": "Feature order must be preserved for inference."
}