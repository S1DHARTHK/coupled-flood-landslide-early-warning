  "rules": {
    "R1_FLOOD_LEVEL": "flood_probability >= 0.5 (replicates the flood-only baseline)",
    "R2_LANDSLIDE_LEVEL": "landslide_probability >= 0.5 (replicates the landslide-only baseline)",
    "R3_SUSTAINED_JOINT": "smoothed coupled probability >= 0.6888 (train p90) for 2 consecutive days",
    "R4_RISING_FLOOD": "smoothed flood probability >= 0.5160 (train p75) AND rising by >= 0.0482 (train p90) over 3 days",
    "R5_RISING_LANDSLIDE": "smoothed landslide probability >= 0.1315 (train p75) AND rising by >= 0.0677 (train p90) over 3 days",
    "R6_ENV_PRECURSOR": "smoothed coupled probability >= 0.5855 (train p75) AND rainfall rising by >= 17.32 mm/day (train p95) AND soil moisture rising by >= 0.0233 (train p90), rates over 3 days",
    "R7_JOINT_MODERATE": "smoothed flood probability >= 0.5360 AND smoothed landslide probability >= 0.1615 simultaneously (both train p80) -- joint moderate risk where neither hazard alone reaches 0.5"
  },
  "rule_classification": {
    "baseline_replicating": [
      "R1_FLOOD_LEVEL",
