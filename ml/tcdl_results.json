  "rules": {
    "R1_FLOOD_LEVEL": "flood_probability >= 0.5 (replicates the flood-only baseline)",
    "R2_LANDSLIDE_LEVEL": "landslide_probability >= 0.5 (replicates the landslide-only baseline)",
    "R3_SUSTAINED_JOINT": "smoothed coupled probability >= 0.8340 (train p90) for 2 consecutive days",
    "R4_RISING_FLOOD": "smoothed flood probability >= 0.3373 (train p75) AND rising by >= 0.0788 (train p90) over 3 days",
    "R5_RISING_LANDSLIDE": "smoothed landslide probability >= 0.3253 (train p75) AND rising by >= 0.0786 (train p90) over 3 days",
    "R6_ENV_PRECURSOR": "smoothed coupled probability >= 0.5953 (train p75) AND rainfall rising by >= 16.21 mm/day (train p95) AND soil moisture rising by >= 0.0775 (train p90), rates over 3 days",
    "R7_JOINT_MODERATE": "smoothed flood probability >= 0.3889 AND smoothed landslide probability >= 0.3820 simultaneously (both train p80) -- joint moderate risk where neither hazard alone reaches 0.5"
  },
  "rule_classification": {
    "baseline_replicating": [
      "R1_FLOOD_LEVEL",
      "R2_LANDSLIDE_LEVEL"
    ],
    "coupling": [
      "R3_SUSTAINED_JOINT",
      "R4_RISING_FLOOD",
      "R5_RISING_LANDSLIDE",
      "R6_ENV_PRECURSOR",
      "R7_JOINT_MODERATE"
    ]
  },
  "coupled_probability_definition": "noisy-OR: 1 - (1 - p_flood)(1 - p_landslide). Assumes conditional independence, which is only an approximation since both hazards share rainfall drivers. Used for ranking, not as a calibrated joint probability.",
